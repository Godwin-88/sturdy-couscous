# EVM RPC endpoints
SEPOLIA_RPC_URL=https://rpc.sepolia.org
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
POLYGON_RPC_URL=https://polygon-rpc.com
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
PRIVATE_KEY=your_private_key

# Contract addresses (filled after deployment)
VERIFIER_ADDRESS=
PASSPORT_ADDRESS=

# ── RWA claim layer (P11 / BUIDL-CTC) — deployed via scripts/deploy-claim.sh ──
CLAIM_TOKEN_CONTRACT=                 # ClaimToken (GASF) address on sepolia
NAV_ANCHOR_CONTRACT=                  # NAVAnchor address on sepolia
CLAIM_TOKEN_PRIVATE_KEY=              # deployer key (owns token operator role)
NAVANCHOR_PRIVATE_KEY=                # deployer key (owns anchor operator role)
