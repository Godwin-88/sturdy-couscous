# ── EVM DeFi relay (P11) — Ethereum Sepolia testnet ─────────────────────
WEB3_ENABLED=0                # 0 disables the whole feature (agent self-disables)
WEB3_TRADING_MODE=paper      # paper | live  (live = relay sends testnet-chain orders)
WEB3_NETWORK=sepolia          # sepolia (11155111) | mainnet (1)
WEB3_RPC_URL=https://rpc.sepolia.org
WEB3_CHAIN_ID=11155111
WEB3_PASSPORT_CONTRACT=0x0    # deployed ZKPassport anchor (stellcasp ethereum/contracts)
WEB3_VERIFIER_CONTRACT=0x0    # deployed UltraHonkVerifier
WEB3_ORACLE_AUTHORITY_PRIVATE_KEY=   # signing key (RFC-6979 via viem); never commit
WEB3_WALLET_ADDRESS=          # derived from the SAME key

# ── D1–D4 gates (mirror agents' MIN_* env; relay rejects sub-threshold intents) ─
MIN_LP_EDGE_PCT=0.05          # D1 gate (fee−IL−gas)
MIN_LENDING_SPREAD_PCT=0.02   # D2 gate
MIN_FUNDING_CARRY_PCT=0.10    # D4 gate
MAX_LEVERAGE_X=2.0            # D3/U32 leverage cap

# ── Relay hygiene (U17 mirror) ─────────────────────────────────────────
DRY_RUN=1                     # log intent; never broadcast until explicitly flipped
RELAY_PORT=8460
RELAY_API_KEY=change-me       # shared secret in X-Relay-Key header
RELAY_RATE_LIMIT_PER_MIN=5    # /order bursts -> 429
HEARTBEAT_MS=30000            # chain-view staleness window
REQUIRED_CONFIRMATIONS=3      # U14 — crediting policy