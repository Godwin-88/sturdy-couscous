# ── DreamDEX / Somnia event-contract relay ─────────────────────────────
DREAMDEX_ENABLED=0              # 0 disables the whole feature (agent self-disables)
DREAMDEX_TRADING_MODE=paper    # paper | live  (live = relay sends testnet-chain orders)
DREAMDEX_NETWORK=testnet        # testnet (50312) | mainnet (5031)
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_PRIVATE_KEY=             # BOT-ONLY key → relay container; never commit
SOMNIA_WALLET_ADDRESS=          # derived from the SAME key
AUTO_CLAIM=1
AUTO_CLAIM_INTERVAL_MS=600000
DRY_RUN=1                        # log intent; never broadcast until explicitly flipped
RELAY_PORT=8450
RELAY_API_KEY=change-me          # U17 — shared secret in X-Relay-Key header
RELAY_RATE_LIMIT_PER_MIN=5       # U17 — /order bursts -> 429
HEARTBEAT_MS=30000               # U17 — chain-view staleness window
REQUIRED_CONFIRMATIONS=3         # U14 — crediting policy (P(race) <= 5.9e-4 at q=0.10 for k=6)