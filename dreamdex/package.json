{
  "name": "graphalpha-somnia-relay",
  "version": "0.1.0",
  "private": true,
  "description": "DreamDEX / Somnia Event-Contract relay for GraphAlpha. Sole owner of SOMNIA_PRIVATE_KEY; narrow HTTP contract for the Python agents. DRY_RUN by default.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "doctor": "tsx src/doctor.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "crypto-hygiene": "tsx src/cryptoHygiene.ts",
    "test": "npm run typecheck && npm run crypto-hygiene"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.29.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.3",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}