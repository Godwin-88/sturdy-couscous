{
  "name": "creditgraph-execution-service",
  "version": "0.1.0",
  "private": true,
  "description": "Creditcoin execution adapter for CreditGraph — wraps the real @polkadot/api to sign and monitor CTC transfer extrinsics on Creditcoin (testnet/mainnet), no mockups.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@polkadot/api": "^12.4.2",
    "@polkadot/keyring": "^13.5.9",
    "@polkadot/util": "^13.5.9",
    "@polkadot/util-crypto": "^13.5.9",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}