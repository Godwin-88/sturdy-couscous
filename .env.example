# ── LLM Configuration (Groq as LLM of choice) ─────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# Optional embeddings for Hybrid GraphRAG vector search (leave blank to disable)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Legacy Featherless (fallback, optional)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=

# ── PostgreSQL Configuration ─────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=graphalpha
POSTGRES_USER=graphalpha
POSTGRES_PASSWORD=changeme

# ── Neo4j Configuration ─────────────────────────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphalpha

# Legacy Memgraph (kept for backward compat during migration)
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687

# ── Redis Configuration ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SIGNALS_CHANNEL=graphalpha:signals:v1
REDIS_SUBSCRIBE=1

# ── Risk Engine Thresholds ────────────────────────────────────────────────────────
AGENT_KELLY_FRACTION=0.5
AGENT_MAX_POSITION_PCT=0.20
RISK_MAX_SECTOR_PCT=0.40
RISK_VAR_CONFIDENCE=0.99
RISK_MAX_VAR_PCT=0.05
AGENT_MAX_DRAWDOWN_HALT=0.10

# ── Agent Cycle Configuration ─────────────────────────────────────────────────────
AGENT_LOOP_INTERVAL_SECONDS=300
NEWS_CYCLE_TICKS=1
MACRO_CYCLE_TICKS=12
RESEARCH_CYCLE_TICKS=12
KG_SIGNAL_TICKERS=SPY,QQQ,XLF,XLE,GLD

# ── Trading Venue (Alpaca primary, Kraken legacy) ────────────────────────────
TRADING_MODE=paper
DEFAULT_VENUE=alpaca

# Alpaca API (paper trading)
ALPACA_API_KEY_ID=your_alpaca_paper_key_id
ALPACA_API_SECRET_KEY=your_alpaca_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# 1 = live agent loop reads bars from Alpaca Market Data API (fallback → yfinance)
ALPACA_MARKET_DATA=1
# 1 = ExecutionAgent uses real Alpaca paper fills (fallback → simulation)
ALPACA_PAPER_REAL_FILLS=1
ALPACA_DATA_CACHE_TTL=240
REGIME_VIX_PROXY_MULT=1.5

# Legacy Kraken API (kept for backward compatibility)
KRAKEN_TRADING_MODE=paper
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── P7 Live Trading Controls ───────────────────────────────────────────────────
LIVE_VALIDATION_SCALE_PCT=  # Set to <100 during validation period (e.g. 10 for 10%)
KILL_SWITCH=  # Set to 1 to immediately halt Kraken live trading

# ── Reconciliation Settings ───────────────────────────────────────────────────────
KRAKEN_RECONCILE_INTERVAL_SECONDS=300
KRAKEN_REENABLE=  # Set to 1 to clear Kraken live halt after manual verification

# ── IBKR Configuration (paper trading only — P6) ──────────────────────────────
IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_HOST=ib-gateway
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper

# ── Backtest Configuration ───────────────────────────────────────────────────────
BACKTEST_CRYPTO_FEE_PCT=0.0026
BACKTEST_CRYPTO_SLIP_PCT=0.0010
BACKTEST_EQUITY_FEE_PCT=0.0010
BACKTEST_EQUITY_SLIP_PCT=0.0005
BT_TRADE_THRESHOLD=0.15

# ── Initial Capital ───────────────────────────────────────────────────────────────
INITIAL_CAPITAL_USD=10000

# ── Research Agent (Speechmatics/FRED for research) ──────────────────────────
SPEECHMATICS_API_KEY=
FRED_API_KEY=

# ── Schema Thresholds ───────────────────────────────────────────────────────────
FUSION_THRESHOLD=0.2
SELL_THRESHOLD=0.2

# ── Frontend / API Configuration ───────────────────────────────────────────────
CORS_ORIGINS=*
VITE_API_URL=http://localhost:8000

# ── Monitoring (optional) ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
PROMETHEUS_URL=http://prometheus:9090
# ── DreamDEX Event Contracts (P9) ────────────────────────────────────────────
# Master switch: 0 = agent self-disables with a warning log; no relay needed.
DREAMDEX_ENABLED=0
DREAMDEX_TRADING_MODE=paper          # paper | live (relay-side intent gate)
DREAMDEX_NETWORK=testnet             # testnet (50312) | mainnet (5031)
DREAMDEX_RELAY_URL=http://localhost:8450
DREAMDEX_MIN_EDGE_PCT=0.03
DREAMDEX_MULTICORR=bh                # off | bonferroni | holm | bh (U10)
DREAMDEX_FDR_DELTA=0.10
MAX_EC_POSITION_PCT_PORTFOLIO=0.02
SOMNIA_RPC_URL=https://dream-rpc.somnia.network
SOMNIA_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql   # Envio/Hasura GraphQL (market discovery)
SOMNIA_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws # chain WS (on-chain reads/writes)
SOMNIA_WALLET_ADDRESS=
SOMNIA_PRIVATE_KEY=                  # BOT-ONLY; NEVER commit; empty ⇒ dry-run
DRY_RUN=1                            # relay never broadcasts while 1
RELAY_API_KEY=                       # shared secret for relay endpoints (U17)
FILL_IMPACT_BPS=20
MIN_ASK_DEPTH_CONTRACTS=5
KURTOSIS_VOL_SCALE=1.0
TAPE_DIVERGENCE_BPS=25
HEARTBEAT_MS=30000

# ── CreditGraph / Attestcoin × Creditcoin (P10) ───────────────────────────
CREDITGRAPH_ENABLED=0              # master switch; agent self-disables when 0
CREDITGRAPH_FROZEN=0               # U6 kill-switch: 1 ⇒ no execution anywhere
CREDITGRAPH_MIN_SCORE=50.0         # min deterministic score to approve an intent
LLM_PROVIDER=deterministic         # deterministic | groq
GROQ_API_KEY=                      # only needed when LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
ATTESTATION_SERVICE_URL=http://attestation-service:8080
EXECUTION_SERVICE_URL=http://execution-service:8081
GRAPHALPHA_API_URL=http://api:8000  # merged gateway the agent scores through
SOURCE_RPC_URL=https://sepolia.infura.io/v3/   # Ethereum Sepolia (Attestcoin chainKey 1)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_WS_URL=wss://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_EXECUTOR_SEED=          # Creditcoin lender seed; NEVER commit; empty ⇒ dry
CREDITGRAPH_DEMO_BORROWERS=        # optional JSON list of {borrower_id, fico_score, dti_ratio, loan_to_value}

# ── EVM DeFi (P11) — Ethereum Sepolia testnet (ported from stellcasp ETHEREUM_*) ─
WEB3_ENABLED=0                 # master switch; defi_agent self-disables
WEB3_TRADING_MODE=paper       # paper | live
WEB3_NETWORK=sepolia           # sepolia (11155111) | mainnet (1)
WEB3_RPC_URL=https://rpc.sepolia.org
WEB3_CHAIN_ID=11155111
WEB3_PASSPORT_CONTRACT=0x0     # deployed ZKPassport anchor (stellcasp ethereum/contracts)
WEB3_VERIFIER_CONTRACT=0x0     # deployed UltraHonkVerifier
WEB3_ORACLE_AUTHORITY_PRIVATE_KEY=  # signing key (RFC-6979; never commit)
WEB3_WALLET_ADDRESS=
WEB3_RELAY_URL=http://localhost:8460
WEB3_RELAY_API_KEY=
MIN_LP_EDGE_PCT=0.05           # D1 gate (fee−IL−gas)
MIN_LENDING_SPREAD_PCT=0.02    # D2 gate
MIN_FUNDING_CARRY_PCT=0.10     # D4 gate
MAX_LEVERAGE_X=2.0             # D3/U32 leverage cap
